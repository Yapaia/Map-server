# Passwort für die Oberfläche (Benutzer: admin). Pflicht.
ADMIN_PASSWORT=

# Token, mit dem Yapaia Go herunterlädt. Leer lassen = wird beim ersten Start
# erzeugt und in der Oberfläche angezeigt.
DOWNLOAD_TOKEN=

# Für HTTPS (docker compose --profile https up -d): die Domain des VPS,
# und BINDEN=127.0.0.1, damit Port 8080 nicht mehr offen im Netz steht.
DOMAIN=
BINDEN=0.0.0.0

# Wie Go den Server erreicht, z. B. https://karten.example.org
# Leer = aus der Anfrage abgeleitet.
OEFFENTLICHE_URL=

# Threads für den Routing-Bau: mehr = schneller, aber mehr RAM. 2 passt zu 8 GB.
VALHALLA_BUILD_THREADS=2
